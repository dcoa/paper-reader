# Copy this file to .env and fill in your own values
SECRET_KEY=change-me

# --- Chat model -----------------------------------------------------------
# Any OpenAI-compatible API. Used for summaries, Q&A and metadata extraction.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=90

# Other providers (uncomment one block instead of the one above):
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat
# Ollama (local, no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# Optional per-task overrides (summary, QA, metadata). Unset values use LLM_*.
# Example: a small, cheap model for metadata extraction
# METADATA_LLM_BASE_URL=https://api.siliconflow.cn/v1
# METADATA_LLM_API_KEY=your-siliconflow-api-key
# METADATA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# SUMMARY_LLM_MODEL=
# QA_LLM_MODEL=

# --- Embeddings -----------------------------------------------------------
# "api" uses an OpenAI-compatible /embeddings endpoint,
# "local" runs the model on this machine (pip install -r backend/requirements-local.txt)
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
